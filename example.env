MAX_BOT_TOKEN=токен бота макс
TELEGRAM_BOT_TOKEN=токен бота telegram

# Telegram webhook — публичный HTTPS URL, который Telegram будет вызывать
WEBHOOK_URL=https://example.com
TELEGRAM_WEBHOOK_PATH=/webhook/tg
MAX_WEBHOOK_PATH=/webhook/max
# Секрет для проверки входящих webhook-запросов (5-256 символов, A-Z a-z 0-9 _ -).
# Настоятельно рекомендуется задать. Пусто — проверка отключена.
WEBHOOK_SECRET=
# Опционально: переопределение хоста/порта внутри контейнера
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=9154

# Путь к файлу маппинга каналов (по умолчанию channels.json)
# CHANNELS_FILE=channels.json

# Redis для сопоставления id сообщений Telegram <-> MAX
REDIS_URL=redis://localhost:6379/0
# TTL в секундах (по умолчанию 864000 = 10 дней)
# MESSAGE_MAP_TTL=864000
